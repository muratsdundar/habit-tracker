{
  "name": "habbit",
  "homepage": "https://muratsdundar.github.io/habit-tracker",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.2",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.3",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.3",
    "expo-splash-screen": "~57.0.2",
    "expo-symbols": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "expo-widgets": "~57.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "gh-pages": "^6.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start -c",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release --device",
    "ios:bundle": "expo export:embed --platform ios --entry-file .expo/.virtual-metro-entry --bundle-output ios/main.jsbundle --assets-dest ios --dev false",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "predeploy": "npm run build:web",
    "deploy": "gh-pages -d dist",
    "lint": "expo lint"
  },
  "private": true
}
